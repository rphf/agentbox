# ~/.config/agentbox/env — personal settings, sourced by bash on every agentbox command (`agentbox init` writes it).
# Both keys are optional. This directory holds everything personal, at fixed paths:
#
#   ~/.config/agentbox/env                this file
#   ~/.config/agentbox/home/              overlaid onto each agent's home: shell rc, agent config, tool config
#   ~/.config/agentbox/secrets/<project>/ files mounted read-only at /run/secrets, per project
#   ~/.config/agentbox/secrets/_shared/   the fallback when a project has no directory of its own

# git author and committer inside agents. Per project in practice, since the bot belongs to one repo's App:
# move them to the project's own settings once you run agents on more than one.
BOT_NAME=agent
BOT_EMAIL=agent@users.noreply.github.com

# Shell `agentbox sh` drops you into. bash and zsh are both in the image; put your rc file in home/.
AGENT_SHELL=bash

# Log every hostname the agent resolves to ~/network.log inside the container (1 = on, 0 = off).
# Read it with `net-log hosts` or `net-log tail`. Hostnames only: HTTPS hides URL paths.
NET_LOG=1
