#!/usr/bin/env bash
# /agentbox/bootstrap — run as `agent` by `agentbox up` from the read-only runtime mount, on every `up`. Idempotent.
# Editing this file needs no image rebuild.
# 1. clone the project into /workspace: from the host checkout when it is mounted, else from REPO_URL
# 2. overlay /agent-home (your agent config, real files) onto $HOME
# 3. hand over to the project's own bootstrap (agentbox-project-bootstrap) when the image has one
set -euo pipefail
cd /workspace

if [ ! -d .git ]; then
  if [ -d /host-repo/.git ]; then
    echo "── cloning from host checkout"   # no GitHub access needed, and the object store is local
    git clone --quiet /host-repo .
    git remote set-url origin "$REPO_URL"
  else
    echo "── cloning $REPO_URL"
    git clone --quiet "$REPO_URL" .
  fi
  git checkout --quiet "${REPO_BRANCH:-main}" 2>/dev/null || true
fi

# Install the co-author hook into this clone (every up, idempotent). A project with its own core.hooksPath
# (e.g. husky) uses that instead and bypasses this.
if [ -d .git ] && [ -f /agentbox/git-hooks/prepare-commit-msg ]; then
  install -m 755 /agentbox/git-hooks/prepare-commit-msg "$(git rev-parse --git-path hooks)/prepare-commit-msg"
fi

# Home overlay: a directory in the overlay is merged into the same directory of the home (created when missing),
# so per-agent state next to it survives; a file is linked in place, so it follows the overlay live and the agent
# cannot alter it. Links left behind by files removed from the overlay are dropped first.
overlay() {
  local entry name target
  for entry in "$1"/.[!.]* "$1"/..?* "$1"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name="${entry##*/}"; target="$2/$name"
    if [ -d "$entry" ] && [ ! -L "$entry" ]; then
      [ -L "$target" ] && rm -f "$target"
      mkdir -p "$target"
      overlay "$entry" "$target"
    else
      ln -sfn "$entry" "$target"
    fi
  done
}
if [ -d /agent-home ] && [ -n "$(ls -A /agent-home)" ]; then
  echo "── home overlay from /agent-home"
  find "$HOME" -maxdepth 3 -type l -lname '/agent-home/*' ! -exec test -e {} \; -delete
  overlay /agent-home "$HOME"
fi

mkdir -p "$HOME/out"

python3 - <<'PY'
import json, os, tempfile
path = os.path.expanduser("~/.claude.json")
try:
    state = json.load(open(path))
except Exception:
    state = {}
before = json.dumps(state, sort_keys=True)
state.setdefault("hasCompletedOnboarding", True)
state.setdefault("hasSeenAutoModeOutsideReadPrompt", True)
state.setdefault("projects", {}).setdefault("/workspace", {})["hasTrustDialogAccepted"] = True
if json.dumps(state, sort_keys=True) != before:
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as fh:
        json.dump(state, fh, indent=2)
    os.replace(tmp, path)
PY
review_section=""
if [ -n "${REVUE_PORT:-}" ]; then
  review_section="$(cat <<REVIEW
## Getting your work reviewed

The human reviews your changes in their browser with revue. The page follows /workspace live, so they see
your edits as you save them; you talk to revue with the \`revue\` CLI from /workspace.

1. Work on a branch and commit. Put screenshots and reports in \`$HOME/out\` (see above).
2. When a piece of work is ready, run \`revue open --no-browser ${REPO_BRANCH:-main}...HEAD\` and put the
   printed link in your final message. Then end your turn; nothing happens until the human has looked.
3. When the human resumes you, run \`revue feedback\`. It holds every unresolved thread with the quoted
   lines, and the note of the human's last send: it says whether to answer, to change something, or that
   you are done. Keep the \`cursor\`; \`revue feedback --since <cursor>\` later shows only what is new.
4. Answer a comment with \`revue reply --thread <id> -m "..."\`. Link evidence in \`$HOME/out\` by its http
   URL; it renders inline.
5. After code changes, commit. The human's page updates by itself; end your turn again with the same link.

Never resolve threads yourself; only the human does. \`revue --help\` lists the rest.

REVIEW
)"$'\n'
fi
cat > "$HOME/AGENTBOX.md" <<EOF
# This machine: an agentbox sandbox

You are \`$(whoami)\` inside a throwaway container named \`${AGENT_NAME:-agentbox}\`, not on the human's machine.
Nothing here is precious except what you hand back, and nothing you do here reaches their laptop.

## Handing work and files back

- Put anything the human should see in \`$HOME/out\`: screenshots, reports, logs, diffs, bundles.
  Each file is then at **http://${AGENT_HOST}:${OUT_PORT:-<no out port>}/<name>** (give that URL, not the path);
  the same host and port also serves the human a control panel at \`/\` — app status with start/stop, the links
  to reviews and the outbox. They pull files with \`agentbox get ${AGENT:-N}\`. Nothing else leaves this container.
- Never write artifacts into the repository at /workspace. That is source, and a stray file shows up in
  \`git status\` and ends up in someone's commit.
- Name files so a list of them reads as a story: \`01-signin.png\`, \`02-dashboard-after-fix.png\`.
- When you finish a piece of work, say where you put things and give the http URL, not just the path.

${review_section}
## Git

Commit in the container as usual. Pushing may fail because the bot token is not installed yet; when it does,
hand the work over as a bundle instead and say so:

\`\`\`bash
git bundle create "\$HOME/out/\$(git branch --show-current).bundle" ${REPO_BRANCH:-main}..HEAD
\`\`\`

The human fetches that bundle and pushes it themselves.

## What is around you

- \`/workspace\` is your own clone. The human's checkout is mounted read-only at \`/host-repo\`; never write there.
- \`$HOME\` persists across restarts of this sandbox. \`/workspace\` too.
- Your hostname is \`${AGENT_HOST}\` and it resolves both here and in the human's browser, so a URL you see works
  for them unchanged. Prefer it over \`localhost\` when you report a link.
- Every hostname you resolve is logged. \`net-log hosts\` shows the list; it is a record, not a restriction.
- An MCP server that asks for an OAuth login cannot finish it through the browser from here: its callback listens
  on a random port inside this container, and the human's browser would open that port on their own machine.
  Use \`claude mcp login <server> --no-browser\`, then paste the redirect URL back when it prompts.
- You may install packages, run migrations, drop databases and force-push branches here. The container is the
  blast radius, and it is cheap to rebuild.
- This sandbox is long-lived. A heavy thing you start — an app server, a browser, a file watcher — keeps running
  and holding memory and CPU until you stop it, even while you sit idle. Start such things when a task needs them
  and stop them when it is done; the project notes below say which commands do that here.

@/workspace/.agentbox/AGENT.md
EOF

if [ -n "${OUT_PORT:-}" ] && ! ss -ltnH "sport = :$OUT_PORT" 2>/dev/null | grep -q .; then
  setsid python3 /agentbox/panel >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
fi

if command -v agentbox-project-bootstrap >/dev/null; then
  echo "── project bootstrap"
  exec agentbox-project-bootstrap
fi
